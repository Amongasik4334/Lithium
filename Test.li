// Функция
func name(): i32 {
	// Неизменяемая переменная
	a: i32 = 5;

	// Изменяемая переменная
	x: i32~ = 10;

	// Срез в куче
	slice: u8[] = std::alloc(64);

	// Защитник (вставляется в конец функции)
	defer std::free(slice);

	// Массив фиксированной длины в стеке
	arr: u8[3] = [0xff, 52, 0b10010];

	// Ссылка на переменную
	ref b: i32 = ref a;
	ref c: i32~ = ref x;

	// a и b ссылаются на одну и ту же область памяти, поэтому изменение a изменяет b.
	val c = 5;

	// Ошибка - a immutable
	val b = 5;

	if a > 5 {
		x = 20;
	} elif a < 5 {
		x = 20;
	} else {
		x = 30;
	}

	for i32 i in 0..=10 {
		x += i;
	}

	str s = struct {
		ref u8[] data = #literal_string("Hello, world!");
		usize len = 13;
	};



	// Match как инструкция: ветки выполняют блоки кода.
	match x {
		20 => {
			x = 30;
		},
		30 => {
			x = 40;
		},
		default => {
			x = 50;
		}
	}

	// Match как выражение: каждая ветка возвращает значение.
	x = match x {
		20 => 30,
		30 => 40,
		default => 50
	};

	return x;
}

struct i32(4): Int
}

// Типы языка будут представлены структурами с intrinsic-операциями.
// Все struct являются примитивами.